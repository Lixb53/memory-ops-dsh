%% 常驻前缀编辑：主路径 + 异常分支（取消 / 校验拒 / 保存失败 / 非回环）
%% 对应 PRD R10–R16
flowchart TB
  subgraph U["用户"]
    u1["在常驻明细点 编辑"]
    u2["改文本"]
    u3["看 diff 与 token Δ"]
    u4["确认保存"]
    u5["取消"]
    u6["点 取消置顶 / 恢复默认"]
  end

  subgraph UI["插件 UI（浏览器半体）"]
    i1["打开编辑器（载入 EditableTarget）"]
    i2{"readOnly?"}
    i3["禁用编辑 + 显示理由 R10"]
    i4["实时预览 diff / tokens 前·后·Δ R11"]
    i5["显示生效时机 新会话生效 R12"]
    i6["二次确认 R16"]
    i7["结果条（成功带路径与改动行数 / 失败带宿主原文） R16"]
    i8["取消并丢弃草稿"]
    i9["只改 pinned=false / 包装回默认；条目保留 R15"]
    lb{"来源是本机回环?"}
    e403["403 结果条：围栏不是失败 R16"]
  end

  subgraph CORE["core 校验与写入"]
    k1["校验: 空标题→拒 / 超预算→警 / 隐私→拒 R14"]
    k2["原子写 tmp+rename，只改目标字段 R13"]
  end

  subgraph FS["文件系统"]
    f1["~/.memory-ops/**/*.md"]
  end

  u1 --> i1 --> i2
  i2 -->|"是"| i3
  i2 -->|"否"| u2 --> i4 --> i5 --> i6
  i6 -->|"确认"| lb
  lb -->|"否"| e403 --> i7
  lb -->|"是"| k1
  i6 -->|"取消"| i8 --> u5
  k1 -->|"拒: 空标题/隐私"| i7
  k1 -->|"通过或仅警告"| k2 --> f1
  f1 -->|"写成功"| i7
  f1 -->|"写失败"| i7
  u3 --> i4
  u4 --> i6
  u6 --> i9 --> i7

  style i3 fill:#eef1f5,stroke:#1f4e79
  style i7 fill:#e8f5ee,stroke:#0d6b3f